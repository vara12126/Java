classDiagram
    direction TB

    class Chargeable {
        <<interface>>
        +calculateFee(int hours)* double
        +calculateDiscountedFee(int hours, double discountPercent) double
        +getCurrencySymbol()$ String
        +printRateCardHeader()$ void
    }

    class Trackable {
        <<interface>>
        +getTrackingTag()* String
        +logMovement(String location) void
    }

    class Vehicle {
        <<abstract>>
        #String registrationNumber
        #String vehicleType
        +getRegistrationNumber() String
        +getDesignatedParkingZone()* String
        +getTrackingTag() String
    }

    class TwoWheeler {
        +calculateFee(int hours) double
        +getDesignatedParkingZone() String
    }

    class Car {
        +calculateFee(int hours) double
        +getDesignatedParkingZone() String
    }

    class ElectricCar {
        -boolean fastChargingActive
        +calculateFee(int hours) double
        +getDesignatedParkingZone() String
    }

    Chargeable <|.. Vehicle : implements
    Trackable <|.. Vehicle : implements
    Vehicle <|-- TwoWheeler
    Vehicle <|-- Car
    Car <|-- ElectricCar
