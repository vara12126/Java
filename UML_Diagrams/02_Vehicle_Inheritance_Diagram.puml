@startuml 02_Vehicle_Inheritance_Diagram
skinparam classAttributeIconSize 0

abstract class Vehicle {
    # registrationNumber : String
    # brand : String
    # vehicleType : String
    + Vehicle(reg : String, brand : String, type : String)
    + {abstract} getHourlyRate() : double
    + getRegistrationNumber() : String
    + displayInfo() : void
}

class TwoWheeler {
    - hasHelmetStorage : boolean
    + TwoWheeler(reg : String, brand : String, helmet : boolean)
    + getHourlyRate() : double
    + isHasHelmetStorage() : boolean
}

class Car {
    # seatingCapacity : int
    + Car(reg : String, brand : String, seats : int)
    + getHourlyRate() : double
    + getSeatingCapacity() : int
}

class ElectricCar {
    - batteryCapacityKWh : double
    - chargingRequired : boolean
    + ElectricCar(reg : String, brand : String, seats : int, kwh : double, charge : boolean)
    + getHourlyRate() : double
    + isChargingRequired() : boolean
}

Vehicle <|-- TwoWheeler : Single / Hierarchical
Vehicle <|-- Car : Hierarchical
Car <|-- ElectricCar : Multilevel
@enduml
