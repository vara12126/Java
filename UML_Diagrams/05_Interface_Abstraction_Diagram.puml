@startuml 05_Interface_Abstraction_Diagram
skinparam classAttributeIconSize 0

interface Chargeable {
    + {abstract} calculateFee(hours : int) : double
    + calculateDiscountedFee(hours : int, discount : double) : double
    + {static} getCurrencySymbol() : String
    + {static} printRateCardHeader() : void
}

interface Trackable {
    + {abstract} getTrackingTag() : String
    + logMovement(location : String) : void
}

abstract class Vehicle {
    # registrationNumber : String
    # vehicleType : String
    + getRegistrationNumber() : String
    + {abstract} getDesignatedParkingZone() : String
    + getTrackingTag() : String
}

class TwoWheeler {
    + calculateFee(hours : int) : double
    + getDesignatedParkingZone() : String
}

class Car {
    + calculateFee(hours : int) : double
    + getDesignatedParkingZone() : String
}

class ElectricCar {
    - fastChargingActive : boolean
    + calculateFee(hours : int) : double
    + getDesignatedParkingZone() : String
}

Chargeable <|.. Vehicle
Trackable <|.. Vehicle
Vehicle <|-- TwoWheeler
Vehicle <|-- Car
Car <|-- ElectricCar
@enduml
