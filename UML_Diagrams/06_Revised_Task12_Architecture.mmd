classDiagram
    direction TB

    class PricingRule {
        <<interface>>
        +computeFee(Vehicle, LocalDateTime, LocalDateTime)* BigDecimal
    }

    class HourlyPricingRule {
        +computeFee(Vehicle, LocalDateTime, LocalDateTime) BigDecimal
    }

    class EBikeFlatPricingRule {
        -BigDecimal flatFee
        +computeFee(Vehicle, LocalDateTime, LocalDateTime) BigDecimal
    }

    class DeliveryVanTimeWindowRule {
        -LocalTime PEAK_START
        -LocalTime PEAK_END
        -double baseRatePerHour
        -double peakMultiplier
        +computeFee(Vehicle, LocalDateTime, LocalDateTime) BigDecimal
    }

    PricingRule <|.. HourlyPricingRule
    PricingRule <|.. EBikeFlatPricingRule
    PricingRule <|.. DeliveryVanTimeWindowRule

    class Pass {
        <<interface>>
        +getPassId()* String
        +getPassType()* String
        +isValid(LocalDateTime)* boolean
        +applyDiscount(BigDecimal)* BigDecimal
    }

    class MonthlyPass {
        -HolderRole role
        -LocalDateTime validFrom
        -LocalDateTime validUntil
        +isValid(LocalDateTime) boolean
        +applyDiscount(BigDecimal) BigDecimal
    }

    class OneDayPass {
        -LocalDateTime issuedAt
        -LocalDateTime expiresAt
        +isValid(LocalDateTime) boolean
        +applyDiscount(BigDecimal) BigDecimal
    }

    Pass <|.. MonthlyPass
    Pass <|.. OneDayPass

    class Vehicle {
        <<abstract>>
        #String registrationNumber
        #String vehicleType
        #PricingRule pricingRule
        +computeFee(LocalDateTime, LocalDateTime) BigDecimal
    }

    class EBike {
        +getBaseHourlyRate() double
    }

    class DeliveryVan {
        +getBaseHourlyRate() double
    }

    class Car {
        +getBaseHourlyRate() double
    }

    class TwoWheeler {
        +getBaseHourlyRate() double
    }

    Vehicle --> PricingRule : Strategy Pattern
    Vehicle <|-- EBike
    Vehicle <|-- DeliveryVan
    Vehicle <|-- Car
    Vehicle <|-- TwoWheeler

    class ExtendedParkingFacility {
        -ParkingSlot[][] grid
        -Map activeSessions
        +park(Vehicle, Pass, LocalDateTime) ActiveSession
        +exit(String, LocalDateTime) BigDecimal
        +displayOccupancy() void
    }

    ExtendedParkingFacility "1" *-- "5 floors" ParkingSlot
